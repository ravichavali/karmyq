    {
      "name": "social-graph-service",
      "port": 3010,
      "status": "production",
      "criticality": "critical",
      "owner": "core",
      "path": "services/social-graph-service",
      "apis": [
        {
          "method": "POST",
          "path": "/invitations/generate",
          "description": "Generate a new invitation code for current user."
        },
        {
          "method": "POST",
          "path": "/invitations/accept",
          "description": "Accept an invitation code during user signup."
        },
        {
          "method": "GET",
          "path": "/invitations",
          "description": "Get invitation history for current user."
        },
        {
          "method": "GET",
          "path": "/invitations/stats",
          "description": "Get inviter statistics for current user (gamification metrics)."
        },
        {
          "method": "GET",
          "path": "/paths/:targetUserId",
          "description": "Get shortest path between current user and target user."
        },
        {
          "method": "POST",
          "path": "/paths/batch",
          "description": "Get paths for multiple target users (optimized for feed ranking)."
        },
        {
          "method": "GET",
          "path": "/network",
          "description": "Returns the current user's local network graph (nodes + edges) from social_graph.connections and community co-membership."
        },
        {
          "method": "GET",
          "path": "/trust-card/:targetUserId",
          "description": "Returns trust tier, karma, trust path, and invitation chain for a target user relative to the current user."
        },
        {
          "method": "GET",
          "path": "/trust/graph",
          "description": "Aggregate ego-network across all of calling user's communities (Sprint 67). Returns calling user + direct neighbors + edges. Used by dashboard Your Network panel."
        },
        {
          "method": "GET",
          "path": "/trust/graph/:communityId",
          "description": "Ego-network for calling user in a community (Sprint 67 rewrite). Returns calling user + direct neighbors only. Response: { nodes, links } with isCurrentUser on nodes."
        },
        {
          "method": "GET",
          "path": "/trust/edge",
          "description": "Returns a single trust edge for a user pair in a community. Returns { data: null } if no edge exists."
        },
        {
          "method": "GET",
          "path": "/trust/decay-config",
          "description": "Returns global Ebbinghaus decay config (base_half_life_days, stability_growth_rate, disappearance_threshold)."
        },
        {
          "method": "GET",
          "path": "/trust/decay-config/:communityId",
          "description": "Returns decay config for a community (falls back to global if no community-specific config exists)."
        },
        {
          "method": "PUT",
          "path": "/trust/decay-config/:communityId",
          "description": "Admin-only: update decay parameters for a specific community."
        }
      ],
      "dependencies": [
        "auth-service",
        "community-service"
      ],
      "infrastructure": [
        "postgres",
        "redis"
      ],
      "events": {
        "publishes": [],
        "subscribes": [
          "match_completed"
        ]
      },
      "healthCheck": "http://localhost:3010/health",
      "notes": "Trust-first design foundation. Sprint 27: match_completed → social_graph.connections. Sprint 65: match_completed → social_graph.trust_edges. Sprint 67: ego-network rewrite — GET /trust/graph (aggregate) + GET /trust/graph/:communityId (community ego-network). Sprint 68: intrinsic Ebbinghaus decay via trust_edges_live view + decay config endpoints. Governance endpoints are in community-service.",
      "databaseSchemas": [
        "social_graph"
      ]
    },
