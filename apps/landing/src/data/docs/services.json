    {
      "name": "auth-service",
      "port": 3001,
      "status": "production",
      "criticality": "critical",
      "owner": "core",
      "path": "services/auth-service",
      "apis": [
        "/auth/register",
        "/auth/login",
        "/auth/verify",
        "/auth/profile",
        "/preferences/request-types",
        "/preferences/interests",
        "/preferences/feed",
        "/auth/profile/tags",
        "/auth/profile/tags/suggestions",
        {
          "method": "POST",
          "path": "/auth/push-tokens",
          "description": "Register an Expo push token for the authenticated user"
        },
        {
          "method": "DELETE",
          "path": "/auth/push-tokens",
          "description": "Remove an Expo push token for the authenticated user"
        },
        {
          "method": "POST",
          "path": "/auth/refresh",
          "description": "Issue new access token using refresh token (ADR-052). Rotates refresh token on each call."
        },
        {
          "method": "POST",
          "path": "/auth/logout",
          "description": "Logout user, revoke access token session and optional refresh token."
        }
      ],
      "dependencies": [],
