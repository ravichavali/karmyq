    {
      "name": "community-service",
      "port": 3002,
      "status": "production",
      "criticality": "critical",
      "owner": "core",
      "path": "services/community-service",
      "apis": [
        {
          "method": "GET",
          "path": "/communities",
          "description": "List communities with filtering and sorting (sort: activity, newest, members, alphabetical)"
        },
        "/communities/join",
        "/communities/my/communities",
        "/communities/:id/config",
        "/communities/config-templates",
        "/communities/configs/public",
        "/communities/:id/config/copy-from/:source_id",
        "/memberships",
        "/norms",
        "/communities/:id/links",
        "/communities/:id/links/:linkId",
        {
          "method": "GET",
          "path": "/communities/tags",
          "description": "Get all distinct community tags for interest-based discovery"
        },
        {
          "method": "PUT",
          "path": "/communities/:id/tags",
          "description": "Update community interest tags (admin only)"
        },
        {
          "method": "PUT",
          "path": "/communities/:id/location",
          "description": "Update community geographic coordinates (admin only)"
        },
        {
          "method": "GET",
          "path": "/communities/trust-questions",
          "description": "List active trust questionnaire questions with choices"
        },
        {
          "method": "POST",
          "path": "/communities/trust-questions",
          "description": "Create a trust question (platform admin)"
        },
        {
          "method": "PUT",
          "path": "/communities/trust-questions/:id",
          "description": "Update a trust question (platform admin)"
        },
        {
          "method": "DELETE",
          "path": "/communities/trust-questions/:id",
          "description": "Deactivate a trust question (platform admin)"
        },
        {
          "method": "POST",
          "path": "/communities/trust-questions/:id/choices",
          "description": "Add a choice to a trust question (platform admin)"
        },
        {
          "method": "PUT",
          "path": "/communities/trust-questions/:id/choices/:choiceId",
          "description": "Update a trust question choice (platform admin)"
        },
        {
          "method": "DELETE",
          "path": "/communities/trust-questions/:id/choices/:choiceId",
          "description": "Remove a trust question choice (platform admin)"
        },
        {
          "method": "GET",
          "path": "/communities/:id/activities",
          "description": "List upcoming open activities for a group community with is_joined flag."
        },
        {
          "method": "POST",
          "path": "/communities/:id/activities",
          "description": "Create a new activity in a group community (admin only)."
        },
        {
          "method": "GET",
          "path": "/communities/:id/activities/:activityId",
          "description": "Get activity detail with participant list."
        },
        {
          "method": "POST",
          "path": "/communities/:id/activities/:activityId/join",
          "description": "Join an activity (returns 400 if full, 409 if already joined)."
        },
        {
          "method": "DELETE",
          "path": "/communities/:id/activities/:activityId/leave",
          "description": "Leave an activity."
        },
        {
          "method": "GET",
          "path": "/communities/:id/governance",
          "description": "Get governance state: settings, maturity, eligible members, pending nominations with ratifier counts, and current role holders."
        },
        {
          "method": "POST",
          "path": "/communities/:id/governance/nominate",
          "description": "Nominate an eligible member (trust score >= threshold) for Admin or Moderator role. Returns 409 if pending nomination already exists."
        },
        {
          "method": "POST",
          "path": "/communities/:id/governance/ratify/:nominationId",
          "description": "Ratify an open nomination (role-holders only). Auto-grants role when quorum is reached."
        },
        {
          "method": "POST",
          "path": "/communities/:id/splits",
          "description": "Admin creates a split proposal; runs trust-graph clustering and seeds member assignments."
        },
        {
          "method": "GET",
          "path": "/communities/:id/splits/:splitId",
          "description": "Get proposal detail, member assignments, and prestige-weighted vote tally."
        },
        {
          "method": "PUT",
          "path": "/communities/:id/splits/:splitId/assignments",
          "description": "Admin bulk-updates member group assignments."
        },
        {
          "method": "POST",
          "path": "/communities/:id/splits/:splitId/start-vote",
          "description": "Admin transitions proposal from discussion to voting phase."
        },
        {
          "method": "POST",
          "path": "/communities/:id/splits/:splitId/vote",
          "description": "Member casts a prestige-weighted vote (yes/no/abstain) on a split proposal."
        },
        {
          "method": "POST",
          "path": "/communities/:id/splits/:splitId/execute",
          "description": "Admin executes an approved split: creates two child communities, moves members, creates split_origin link, marks parent as split."
        }
      ],
      "dependencies": [
        "auth-service"
      ],
      "infrastructure": [
        "postgres",
        "redis",
        "bull-queue"
      ],
      "events": {
        "publishes": [
          "user_joined_community",
          "community_created",
          "community.config.created",
          "community.config.updated",
          "activity_joined"
        ],
        "subscribes": []
      },
      "healthCheck": "http://localhost:3002/health",
      "notes": "Sprint 47: Group Communities — community_type field, activities + activity_participants tables, activities API endpoints, activity_joined event",
      "databaseSchemas": [
        "community"
      ]
    },
    {
      "name": "request-service",
      "port": 3003,
      "status": "production",
      "criticality": "critical",
      "owner": "core",
      "path": "services/request-service",
      "apis": [
        "/requests",
        "/requests/:id",
        "/requests/curated",
        "/offers",
        "/matches",
        "/matches/:id/complete",
        "/schemas",
        "/schemas/:type",
        "/admin/schemas",
        "/admin/schemas/:id",
        "/admin/schemas/:id/publish",
        "/admin/schemas/:id/archive",
        "/admin/schemas/:id/versions",
        "/admin/schemas/:id/rollback/:version",
        "/admin/schemas/:id/variants",
        "/providers",
        "/providers/my",
        "/providers/:id",
        "/collectives/my",
        "/collectives/:id/stats",
        "/providers/:id/availability",
        "/requests/:id/admin-triage",
        "/providers/:id/rate-cards",
        "/providers/:id/rate-cards/:cardId",
        {
          "method": "POST",
          "path": "/requests/:id/boost",
          "description": "Boost a request for 48h; active boost adds +30 to feedScore (capped at 100) and returns is_boosted + boosted_expires_at in curated feed (admin only)"
        },
        {
          "method": "DELETE",
          "path": "/requests/:id/boost",
          "description": "Remove active boost from a request (admin only)"
        },
        {
          "method": "POST",
          "path": "/requests/:id/propose-match",
          "description": "Admin proposes a specific community member as a helper (creates proposed match with admin_proposed=TRUE on requests.matches)"
        },
        {
          "method": "PATCH",
          "path": "/requests/:id/urgent",
          "description": "Toggle request urgency between urgent and medium (admin only)"
        },
        {
          "method": "GET",
          "path": "/requests/:id/offers",
          "description": "List provider offers on a request (requester only)"
        },
        {
          "method": "PUT",
          "path": "/requests/offers/:id/accept",
          "description": "Accept a pending provider offer and create a match"
        },
        {
          "method": "PUT",
          "path": "/requests/offers/:id/decline",
          "description": "Decline a pending provider offer"
        },
        {
          "method": "POST",
          "path": "/providers/offers",
          "description": "Submit a provider offer on an open help request"
        },
        {
          "method": "GET",
          "path": "/providers/offers",
          "description": "List offers submitted by the authenticated provider"
        },
        {
          "method": "PUT",
          "path": "/providers/offers/:id/withdraw",
          "description": "Withdraw a pending provider offer"
        },
        {
          "method": "GET",
          "path": "/requests/:id/dibs-candidate",
          "description": "Returns top-scored dibs candidate for any request; ?type=service uses provider-profile candidates, all others use mutual-aid candidates"
        },
        {
          "method": "POST",
          "path": "/requests/:id/dibs",
          "description": "Send dibs to a specific provider or community member — works for all request types (scheduled and ASAP)"
        },
        {
          "method": "PUT",
          "path": "/requests/dibs/:id/accept",
          "description": "Provider accepts dibs — creates matches record and sets request status to matched"
        },
        {
          "method": "PUT",
          "path": "/requests/dibs/:id/decline",
          "description": "Provider declines dibs — request reverts to open"
        },
        {
          "method": "GET",
          "path": "/requests/dibs/pending-for-provider",
          "description": "Returns authenticated provider's pending dibs"
        }
      ],
      "dependencies": [
        "auth-service",
        "community-service"
      ],
      "infrastructure": [
        "postgres",
        "redis",
        "bull-queue"
      ],
      "events": {
        "publishes": [
          "match_completed",
          "request_created",
          "offer_created",
          "preferred_provider_selected",
          "provider_went_on_duty",
          "offer_submitted",
          "offer_accepted",
          "offer_declined",
          "dibs_submitted",
          "dibs_accepted",
          "dibs_declined"
        ],
        "subscribes": []
      },
      "healthCheck": "http://localhost:3003/health",
      "notes": "Server-driven UI: Schema API provides dynamic form definitions. Admin API enables zero-code request type creation. Sprint 43: feed_events table logs impressions/outcomes for weight tuning (ADR-048).",
      "databaseSchemas": [
        "requests"
      ]
