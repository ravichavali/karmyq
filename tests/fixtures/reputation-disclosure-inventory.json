{
  "policy": "ADR-082 Reputation Disclosure Boundary (Sprint 112)",
  "description": "Authoritative inventory of every reputation-bearing outward endpoint: disclosure class, bound schema (a real @karmyq/shared strict export or an approved sentinel), the contract test that owns its assertions, and — for privacy-critical ordinary_member contracts — a representative key-clean sample_response. Denial fixtures use the ADR-074 string-code envelope. The disclosure CI gate cross-checks this file against services/registry.json in both directions.",
  "sentinel_schemas": {
    "self_only": "self-only legacy read; guarantee is JWT-identity auth, proven in the contract test (not key absence, since self responses legitimately carry the caller's own metrics)",
    "provider_public": "opted-in public provider-rating exception",
    "community_aggregate": "non-identifying community aggregate, >=5-member cohort enforced in-service",
    "community_policy": "community decay/evolution policy aggregate (no member rows)",
    "internal_admin_policy": "community-admin configuration surface; never carries member parameters",
    "retired_410": "endpoint retired with an ADR-074 410 envelope"
  },
