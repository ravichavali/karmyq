{
  "name": "@karmyq/tests",
  "version": "4.0.0",
  "description": "Integration and E2E tests for Karmyq multi-tenant platform",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:regression",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:setup": "docker compose -f docker-compose.test.yml up -d && docker compose -f docker-compose.test.yml ps",
    "test:integration:teardown": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:logs": "docker compose -f docker-compose.test.yml logs -f",
    "test:integration:run": "docker compose -f docker-compose.test.yml run --rm test-runner",
    "test:integration:full": "npm run test:integration:setup && npm run test:integration && npm run test:integration:teardown",
    "test:unit": "jest --testPathPattern=unit/ --passWithNoTests",
    "test:auth": "jest integration/auth.test.ts",
    "test:tenant": "jest integration/tenant-isolation.test.ts",
    "test:rls": "jest integration/rls-policies.test.ts",
    "test:flows": "jest integration/multi-community-flows.test.ts",
    "test:ephemeral": "jest integration/ephemeral-data.test.ts",
    "test:decay": "jest integration/reputation-decay.test.ts",
    "test:phase3": "jest integration/ephemeral-data.test.ts integration/reputation-decay.test.ts",
    "test:e2e": "jest e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "seed": "ts-node scripts/seed-data.ts",
    "seed:quick": "ts-node scripts/seed-data.ts --profile quick",
    "seed:staging": "ts-node scripts/seed-data.ts --profile staging",
    "seed:production": "ts-node scripts/seed-data.ts --profile production",
    "generate-test-data": "ts-node fixtures/generate-realistic-data.ts",
    "load-test-data": "cat fixtures/realistic-test-data.sql | docker exec -i karmyq-postgres psql -U karmyq_user -d karmyq_db",
    "cleanup-test-data": "ts-node scripts/cleanup-test-data.ts",
    "cleanup-test-data:dry-run": "ts-node scripts/cleanup-test-data.ts --dry-run",
    "cleanup-test-data:force": "ts-node scripts/cleanup-test-data.ts --force",
    "test:regression": "jest --testPathPattern=regression/ --passWithNoTests",
    "test:tdd": "jest --testPathPattern=tdd/ --passWithNoTests"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.memoize": "^4.1.9",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^7.2.0",
    "bs-logger": "^0.2.6",
    "jest": "^29.7.0",
    "lodash.memoize": "^4.1.2",
    "make-error": "^1.3.6",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "supertest": "^7.2.2"
  }
}
