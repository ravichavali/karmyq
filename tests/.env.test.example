# Integration Test Environment Variables
#
# Copy this file to .env.test and adjust if needed
# These are defaults that work with docker-compose.test.yml

# Node Environment
NODE_ENV=test

# Database (PostgreSQL)
DATABASE_URL=postgresql://karmyq_test:test_password@localhost:5433/karmyq_test

# Redis
REDIS_URL=redis://localhost:6380

# JWT Configuration
JWT_SECRET=test_jwt_secret_change_me
JWT_EXPIRES_IN=24h

# Service URLs (when running on host, not in Docker)
AUTH_SERVICE_URL=http://localhost:3001
COMMUNITY_SERVICE_URL=http://localhost:3002
REQUEST_SERVICE_URL=http://localhost:3003
REPUTATION_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
MESSAGING_SERVICE_URL=http://localhost:3006
SOCIAL_GRAPH_API_URL=http://localhost:3010

# When running tests inside Docker (via test-runner container),
# these URLs are overridden by docker-compose.test.yml to use
# Docker service names instead of localhost.
