# Dockerfile for integration test runner
# Runs tests inside Docker network with access to all services
# Note: tests directory is mounted as volume, not copied during build

FROM node:24-alpine

WORKDIR /app

# Copy root package files first
COPY package*.json ./
COPY turbo.json ./

# Copy workspace packages (needed for dependencies)
COPY packages ./packages
COPY services ./services
# Sprint 126: the integration suites apply infrastructure/postgres/migrations/*.sql directly, so the
# migration chain must be present in the image. Without it they fail with ENOENT on the migration.
COPY infrastructure ./infrastructure

# Install all dependencies
RUN npm ci

# Create tests directory (will be populated by volume mount)
RUN mkdir -p /app/tests

# Set working directory to tests
WORKDIR /app/tests

# Note: npm ci for tests runs via volume-mounted package.json
# Test dependencies are installed when container starts

# Create results directory
RUN mkdir -p /app/tests/results

# Default command (can be overridden)
CMD ["sh", "-c", "npm ci && npm run test:integration"]
