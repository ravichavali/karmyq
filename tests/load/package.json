{
  "name": "karmyq-load-tests",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "Load and performance tests for Karmyq platform",
  "private": true,
  "scripts": {
    "test": "npx ts-node load-test.ts",
    "test:light": "LOAD_TEST_USERS=5 LOAD_TEST_DURATION=15 npx ts-node load-test.ts",
    "test:heavy": "LOAD_TEST_USERS=50 LOAD_TEST_DURATION=60 npx ts-node load-test.ts",
    "test:stress": "LOAD_TEST_USERS=100 LOAD_TEST_DURATION=120 npx ts-node load-test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "dotenv": "^16.3.1"
  }
}
