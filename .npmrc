# Block dependency lifecycle scripts on install — removes the npm-worm execution
# vector (ADR-061). Trade-off: git hooks no longer auto-install on `npm ci`; run
# `npm run hooks:install` explicitly after clone (documented in CLAUDE.md/README).
ignore-scripts=true

legacy-peer-deps=true
# Prevent expo packages from being hoisted to root to avoid version conflicts
hoist-pattern[]=!expo*
hoist-pattern[]=!@expo/*
hoist-pattern[]=!react-native*
hoist-pattern[]=!@react-native/*
