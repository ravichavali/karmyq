{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["jest", "node"]
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "jest.config.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "api/mobile-storage.ts",
    "api/web-storage.ts"
  ]
}
