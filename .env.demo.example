# Demo Environment Variables
# COPY THIS TO .env.demo on the server
# Then fill in the secure values marked with <change_me>

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=karmyq_user
POSTGRES_PASSWORD=<change_me>
POSTGRES_DB=karmyq_production
DATABASE_URL=postgresql://karmyq_user:<change_me>@postgres:5432/karmyq_production

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=<change_me>

# Generate independently; request-service ↔ social-graph-service only
INTERNAL_SECRET=<change_me>

# Comma-separated list of allowed CORS origins (Sprint 54 — ADR-052)
# karmyq.org/.www are required for the cross-origin founding-circle POST (Sprint 96 — ADR-076):
# the static landing site (karmyq.org) submits the /join form to auth-service on karmyq.com.
ALLOWED_ORIGINS=https://karmyq.com,https://karmyq.org,https://www.karmyq.org

# Founding-circle review allowlist (Sprint 103 — ADR-076). Deny-by-default:
# if BOTH are empty, the reviewer endpoints 403 everyone. A reviewer must be listed
# here AND be an active community admin. The value here must exactly match (case-
# insensitive) the email/userId in the reviewer's JWT. Comma-separated.
# These are passed through to auth-service in docker-compose.prod.yml.
FOUNDING_CIRCLE_REVIEWER_EMAILS=
FOUNDING_CIRCLE_REVIEWER_IDS=

# =============================================================================
# RUNTIME
# =============================================================================
NODE_ENV=production
# Set to true to disable rate limiting (useful during data seeding)
RATE_LIMIT_DISABLED=false

# =============================================================================
# PUBLIC URL (used by backend services to generate shareable links)
# =============================================================================
FRONTEND_URL=https://karmyq.com

# =============================================================================
# FRONTEND (baked into Next.js at build time)
# Using /api prefix - nginx proxies to backend services
# =============================================================================
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_COMMUNITY_API_URL=/api
NEXT_PUBLIC_REQUEST_API_URL=/api
NEXT_PUBLIC_REPUTATION_API_URL=/api
NEXT_PUBLIC_NOTIFICATION_API_URL=/api
NEXT_PUBLIC_MESSAGING_API_URL=/api
NEXT_PUBLIC_SOCIAL_GRAPH_API_URL=/api

# =============================================================================
# INTERNAL SERVICE URLS (Docker network)
# =============================================================================
AUTH_API_URL=http://auth-service:3001
COMMUNITY_API_URL=http://community-service:3002
REQUEST_API_URL=http://request-service:3003
REPUTATION_API_URL=http://reputation-service:3004
NOTIFICATION_API_URL=http://notification-service:3005
MESSAGING_API_URL=http://messaging-service:3006
GEOCODING_API_URL=http://geocoding-service:3009
SOCIAL_GRAPH_API_URL=http://social-graph-service:3010

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme
