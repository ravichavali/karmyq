# =============================================================================
# Karmyq Simulation Configuration
# Copy to .env and fill in values for your environment
# =============================================================================

# Where the app runs (NOT where the simulation runs)
# Demo server (co-located):
TARGET_BASE_URL=http://localhost:3000
TARGET_API_URL=http://localhost

# Remote/external box:
# TARGET_BASE_URL=https://karmyq.com
# TARGET_API_URL=https://karmyq.com/api

# Observability (co-located demo server)
PROMETHEUS_PUSH_GATEWAY=http://localhost:9091
LOKI_URL=http://localhost:3100

# Observability (external sim box)
# PROMETHEUS_PUSH_GATEWAY=https://karmyq.com/pushgateway
# LOKI_URL=https://karmyq.com/loki

# Simulation behavior
SIM_MAX_USERS=50
SIM_CONCURRENCY=5
SIM_LOAD_PROFILE=steady
# SIM_LOAD_PROFILE=spike
# SIM_LOAD_PROFILE=ramp

# Tick interval: how often each persona takes an action (milliseconds)
SIM_TICK_INTERVAL_MS=5000
# Add jitter to avoid metronomic behavior (milliseconds, random range 0..N)
SIM_TICK_JITTER_MS=3000

# Database — reset script only (connects directly to drop @test.karmyq.com data)
DATABASE_URL=postgresql://karmyq:karmyq_password@localhost:5432/karmyq

# JWT secret (needed only if using token refresh — normally sim uses login API)
# JWT_SECRET=your-secret
