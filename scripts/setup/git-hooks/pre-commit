#!/bin/bash
#
# Karmyq Pre-Commit Hook
# Runs before every commit to ensure code quality
#

set -e

echo "🔍 Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
  echo -e "${RED}❌ Error: Not in project root directory${NC}"
  exit 1
fi

# 1. TypeScript type checking
echo ""
echo "📝 Running TypeScript type check..."
if npm run type-check --workspaces --if-present; then
  echo -e "${GREEN}✓ TypeScript type check passed${NC}"
else
  echo -e "${RED}❌ TypeScript type check failed${NC}"
  echo -e "${YELLOW}Fix type errors before committing${NC}"
  exit 1
fi

# 2. Integration tests (quick subset)
echo ""
echo "🧪 Running integration tests..."
cd tests
if npm run test:integration -- --maxWorkers=2; then
  echo -e "${GREEN}✓ Integration tests passed${NC}"
else
  echo -e "${RED}❌ Integration tests failed${NC}"
  echo -e "${YELLOW}Fix failing tests before committing${NC}"
  cd ..
  exit 1
fi
cd ..

# 3. Lint staged files (if we have a linter setup)
# Uncomment when ESLint is configured
# echo ""
# echo "🎨 Running linter on staged files..."
# npx lint-staged

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo ""
