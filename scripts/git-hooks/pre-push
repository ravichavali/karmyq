#!/bin/bash
# Pre-push hook for karmyq
# Runs tests before pushing to ensure code quality
#
# To install: Run `npm run hooks:install`
# To skip: git push --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "🚀 Running pre-push checks..."

# Allow skipping via environment variable
if [ "$SKIP_PREPUSH" = "1" ]; then
  echo -e "${YELLOW}⚠️  Skipping pre-push checks (SKIP_PREPUSH=1)${NC}"
  exit 0
fi

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
  echo -e "${RED}❌ Error: Not in project root directory${NC}"
  exit 1
fi

# Function to check if PostgreSQL is available
check_postgres() {
  if [ -z "$DATABASE_URL" ] && [ -z "$POSTGRES_HOST" ]; then
    return 1
  fi

  # Try to connect using pg_isready if available, or a simple query
  if command -v pg_isready &> /dev/null; then
    pg_isready -h "${POSTGRES_HOST:-localhost}" -p "${POSTGRES_PORT:-5432}" &> /dev/null
    return $?
  fi

  # Fallback: assume it's available if DATABASE_URL is set
  [ -n "$DATABASE_URL" ]
  return $?
}

# 1. Run integration tests if database is available
echo ""
echo "🧪 Checking integration tests..."

if check_postgres; then
  echo -e "${BLUE}ℹ️  Database detected, running integration tests...${NC}"
  cd tests
  if npm run test:integration; then
    echo -e "${GREEN}✓ Integration tests passed${NC}"
  else
    echo -e "${RED}❌ Integration tests failed${NC}"
    echo -e "${YELLOW}Fix failing tests or use --no-verify to skip${NC}"
    cd ..
    exit 1
  fi
  cd ..
else
  echo -e "${YELLOW}⚠️  Database not available, skipping integration tests${NC}"
  echo -e "${BLUE}ℹ️  Set DATABASE_URL or ensure PostgreSQL is running to enable integration tests${NC}"
fi

# 2. Run unit + regression tests (MUST PASS - TDD Framework)
echo ""
echo "🔬 Running unit + regression tests..."
echo -e "${BLUE}ℹ️  These tests MUST pass (core tenant of TDD framework)${NC}"
if npm test; then
  echo -e "${GREEN}✓ Unit + regression tests passed${NC}"
else
  echo -e "${RED}❌ Unit + regression tests failed${NC}"
  echo -e "${YELLOW}Fix failing tests or use --no-verify to skip${NC}"
  exit 1
fi

# 3. Run TDD tests (report only, don't block)
echo ""
echo "🧪 Running TDD tests (work in progress)..."
echo -e "${BLUE}ℹ️  These tests can fail - they're in development${NC}"
if npm run test:tdd 2>&1 | tail -20; then
  echo -e "${GREEN}✓ TDD tests passed - consider promoting to regression!${NC}"
else
  echo -e "${YELLOW}⚠️  TDD tests failed (this is OK, they're in development)${NC}"
fi

echo ""
echo -e "${GREEN}✅ All required checks passed!${NC}"
echo -e "${BLUE}ℹ️  To skip checks: git push --no-verify${NC}"
echo -e "${BLUE}ℹ️  To skip via env: SKIP_PREPUSH=1 git push${NC}"
echo ""
