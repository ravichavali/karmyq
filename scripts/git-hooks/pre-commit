#!/bin/bash
# Pre-commit hook for service governance and feedback loops
# 1. Runs impact analysis when service files are changed
# 2. Detects changes that require documentation updates
#
# To install: ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit

# Get list of changed files
changed_files=$(git diff --cached --name-only)
# Exclude auto-generated governance files from triggering analysis
filtered_files=$(echo "$changed_files" | grep -v 'services/dependency-graph.md' | grep -v 'services/impact-analysis.md' | grep -v 'services/version-drift.md')
changed_services=$(echo "$filtered_files" | grep '^services/' | grep -v '/node_modules/' | cut -d/ -f2 | sort -u)

# 1. Impact Analysis
if [ -n "$changed_services" ]; then
  echo ""
  echo "🔍 Service changes detected in: $changed_services"
  echo "   Running impact analysis..."
  echo ""

  # Run service analysis
  node scripts/analyze-services.js > /dev/null

  echo "📊 Impact Analysis:"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  # Show impacted services for each changed service
  for service in $changed_services; do
    if [ -f "services/impact-analysis.md" ]; then
      echo ""
      echo "Changed: $service"
      # Extract impact info from markdown
      grep -A 10 "### $service" services/impact-analysis.md | grep -E "(Impacts|No direct|⚠️|✅)" | head -5 || echo "  → See services/impact-analysis.md"
    fi
  done

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "✓ Review services/impact-analysis.md for full details"
  echo ""
fi

# 2. Feedback Loop Detection
echo "🔄 Checking for required documentation updates..."
node scripts/feedback-loop.js

# Continue with commit
exit 0
