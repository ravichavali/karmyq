{
  "name": "karmyq-request-service",
  "version": "1.0.0",
  "description": "Karmyq Request Service - Help requests and offers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:regression",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration",
    "test:regression": "jest tests/regression --passWithNoTests",
    "test:tdd": "jest tests/tdd --passWithNoTests"
  },
  "dependencies": {
    "@karmyq/shared": "*",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "jest": "^29.5.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
