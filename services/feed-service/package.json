{
  "name": "karmyq-feed-service",
  "version": "1.0.0",
  "description": "Karmyq Feed Service - Community activity and personalized feed",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:regression",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration",
    "test:regression": "jest tests/regression --passWithNoTests",
    "test:tdd": "jest tests/tdd --passWithNoTests"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "jest": "^29.5.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
