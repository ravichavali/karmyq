{
  "name": "@karmyq/social-graph-service",
  "version": "9.1.0",
  "description": "Social graph and trust path computation service for Karmyq",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:regression",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration",
    "test:regression": "jest tests/regression --passWithNoTests",
    "test:tdd": "jest tests/tdd --passWithNoTests"
  },
  "dependencies": {
    "@karmyq/shared": "*",
    "@types/cors": "^2.8.19",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
