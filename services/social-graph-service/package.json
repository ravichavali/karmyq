{
  "name": "@karmyq/social-graph-service",
  "version": "9.1.0",
  "description": "Social graph and trust path computation service for Karmyq",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:regression",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration",
    "test:regression": "jest tests/regression --passWithNoTests",
    "test:tdd": "jest tests/tdd --passWithNoTests"
  },
  "dependencies": {
    "@karmyq/shared": "*",
    "@types/cors": "^2.8.19",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "jest": "^30.4.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
