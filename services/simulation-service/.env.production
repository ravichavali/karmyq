# Production Configuration for Simulation Service
# Copy this to production server and adjust values

# API Configuration
API_BASE_URL=https://karmyq.com/api

# Simulation Control
SIMULATION_ENABLED=true
ENVIRONMENT=production

# Session Configuration
MIN_CONCURRENT_SESSIONS=5
MAX_CONCURRENT_SESSIONS=15
TOTAL_USERS=20

# User Profiles Distribution (must sum to 1.0)
PROFILE_ACTIVE_HELPER=0.30
PROFILE_REQUESTER=0.25
PROFILE_BROWSER=0.25
PROFILE_COMMUNITY_BUILDER=0.10
PROFILE_SOCIAL_USER=0.10

# Rate Limiting
RESPECT_RATE_LIMITS=true
MIN_DELAY_MS=2000
MAX_RETRIES=3

# Business Hours (Pacific Time)
BUSINESS_HOURS_ENABLED=true
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=21:00
BUSINESS_HOURS_TIMEZONE=America/Los_Angeles

# Logging
LOG_LEVEL=info
LOG_FILE=logs/simulation.log

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
