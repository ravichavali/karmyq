# Test Configuration for Simulation Service
# Short test run with minimal activity

# API Configuration
API_BASE_URL=http://localhost:3001

# Simulation Control
SIMULATION_ENABLED=true
ENVIRONMENT=dev

# Session Configuration (low numbers for testing)
MIN_CONCURRENT_SESSIONS=2
MAX_CONCURRENT_SESSIONS=3

# Rate Limiting
RESPECT_RATE_LIMITS=true
MIN_DELAY_MS=2000
MAX_RETRIES=3

# Business Hours (disabled for testing)
BUSINESS_HOURS_ENABLED=false

# Logging
LOG_LEVEL=info
