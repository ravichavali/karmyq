# Karmyq Synthetic User Simulation Service
# Copy to .env and configure

# Required: API base URL for Karmyq platform
API_BASE_URL=http://localhost:3000/api

# Optional: Enable/disable simulation
SIMULATION_ENABLED=true

# Optional: Environment (dev, staging, production)
ENVIRONMENT=production

# Optional: Concurrent session limits
MIN_CONCURRENT_SESSIONS=10
MAX_CONCURRENT_SESSIONS=50

# Optional: Business hours (Pacific Time)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=21:00
TIMEZONE=America/Los_Angeles

# Optional: Rate limiting
RATE_LIMIT_MIN_DELAY_MS=2000
RATE_LIMIT_MAX_RETRIES=3
