          "/collectives/my",
          "/collectives/:id/stats",
          "/providers/:id/availability",
          "/requests/:id/admin-triage",
          "/providers/:id/rate-cards",
          "/providers/:id/rate-cards/:cardId",
          {"method": "POST", "path": "/requests/:id/boost", "description": "Boost a request for 48h, adding +0.3 feed score (admin only)"},
          {"method": "DELETE", "path": "/requests/:id/boost", "description": "Remove active boost from a request (admin only)"},
          {"method": "POST", "path": "/requests/:id/propose-match", "description": "Admin proposes a specific community member as a helper (creates proposed match)"},
          {"method": "PATCH", "path": "/requests/:id/urgent", "description": "Toggle request urgency between urgent and medium (admin only)"}
        ],
        "consumes": [
          "/auth/verify",
          "/communities/validate"
        ]
      },
      "database_schemas": [
        "requests"
      ],
      "health_check": "http://localhost:3003/health",
      "criticality": "critical",
      "events": {
        "publishes": [
          "match_completed",
          "request_created",
          "offer_created",
          "preferred_provider_selected"
        ],
        "subscribes": []
      },
      "notes": "Server-driven UI: Schema API provides dynamic form definitions. Admin API enables zero-code request type creation."
    },
