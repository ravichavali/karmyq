          "/norms",
          "/communities/:id/links",
          "/communities/:id/links/:linkId",
          {"method": "GET", "path": "/communities/tags", "description": "Get all distinct community tags for interest-based discovery"},
          {"method": "PUT", "path": "/communities/:id/tags", "description": "Update community interest tags (admin only)"},
          {"method": "PUT", "path": "/communities/:id/location", "description": "Update community geographic coordinates (admin only)"}
        ],
        "consumes": [
          "/auth/verify"
        ]
      },
      "database_schemas": [
        "community"
      ],
      "health_check": "http://localhost:3002/health",
      "criticality": "critical",
