    "social-graph-service": {
      "port": 3010,
      "status": "production",
      "owner": "core",
      "path": "services/social-graph-service",
      "dependencies": {
        "services": [
          "auth-service",
          "community-service"
        ],
        "infrastructure": [
          "postgres",
          "redis"
        ]
      },
      "apis": {
        "provides": [
          { "method": "POST", "path": "/invitations/generate", "description": "Generate a new invitation code for current user." },
          { "method": "POST", "path": "/invitations/accept", "description": "Accept an invitation code during user signup." },
          { "method": "GET", "path": "/invitations", "description": "Get invitation history for current user." },
          { "method": "GET", "path": "/invitations/stats", "description": "Get inviter statistics for current user (gamification metrics)." },
          { "method": "GET", "path": "/paths/:targetUserId", "description": "Get shortest path between current user and target user." },
          { "method": "POST", "path": "/paths/batch", "description": "Get paths for multiple target users (optimized for feed ranking)." },
          { "method": "GET", "path": "/network", "description": "Returns the current user's local network graph (nodes + edges) from social_graph.connections and community co-membership." }
        ],
        "consumes": [
          "/auth/verify"
        ]
      },
      "database_schemas": [
        "social_graph"
