{
  "name": "karmyq",
  "version": "9.26.0",
  "private": true,
  "description": "Community Mutual Aid Platform - Privacy-First Community Health Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "posttest": "node scripts/promote-tdd-tests.js",
    "test:unit": "turbo run test:unit",
    "test:regression": "turbo run test:regression",
    "test:tdd": "turbo run test:tdd",
    "test:integration": "cd tests && npm run test:integration",
    "test:watch": "cd tests && npm run test:watch",
    "test:coverage": "cd tests && npm run test:coverage",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "analyze:services": "node scripts/analyze-services.js",
    "health:check": "bash scripts/health-check.sh",
    "dashboard": "node scripts/dashboard.js",
    "feedback:check": "node scripts/feedback-loop.js",
    "context:generate": "node scripts/generate-service-context.js",
    "hooks:install": "sh scripts/install-hooks.sh",
    "audit": "npm audit --audit-level=high",
    "postinstall": "test -f scripts/install-hooks.sh && sh scripts/install-hooks.sh || exit 0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "prettier": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "axios": "1.15.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "overrides": {
    "tar": ">=7.5.11",
    "minimatch": ">=9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "npm@10.8.2"
}
