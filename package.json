{
  "name": "karmyq",
  "version": "11.26.0",
  "private": true,
  "description": "Community Mutual Aid Platform - Privacy-First Community Health Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "posttest": "node scripts/promote-tdd-tests.js",
    "test:unit": "turbo run test:unit",
    "test:regression": "turbo run test:regression",
    "test:tdd": "turbo run test:tdd",
    "test:integration": "cd tests && npm run test:integration",
    "test:watch": "cd tests && npm run test:watch",
    "test:coverage": "cd tests && npm run test:coverage",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "analyze:services": "node scripts/analyze-services.js",
    "health:check": "bash scripts/health-check.sh",
    "dashboard": "node scripts/dashboard.js",
    "feedback:check": "node scripts/feedback-loop.js",
    "context:generate": "node scripts/generate-service-context.js",
    "hooks:install": "sh scripts/install-hooks.sh",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "prettier": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "tar": "7.5.15",
    "minimatch": ">=9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@xmldom/xmldom": "^0.8.13",
    "node-forge": ">=1.4.0",
    "fast-uri": ">=3.1.2",
    "qs": ">=6.15.2",
    "ip-address": ">=10.1.1",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "picomatch@3.0.0 - 3.0.1": ">=4.0.4",
    "ws@8.0.0 - 8.20.0": ">=8.20.1",
    "engine.io": {
      "ws": "8.21.0"
    },
    "engine.io-client": {
      "ws": "8.21.0"
    },
    "socket.io-adapter": {
      "ws": "8.21.0"
    },
    "form-data@4.0.0 - 4.0.5": "4.0.6",
    "brace-expansion@5.0.2 - 5.0.5": ">=5.0.6",
    "js-yaml": "4.2.0",
    "jsdom": {
      "ws": ">=8.20.1"
    },
    "@swc/helpers": "0.5.15",
    "ts-jest": "29.4.6",
    "undici@7.0.0 - 7.27.2": "^7.28.0"
  },
  "packageManager": "npm@10.8.2"
}
