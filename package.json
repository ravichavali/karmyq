{
  "name": "karmyq",
  "version": "7.0.0",
  "private": true,
  "description": "Community Mutual Aid Platform - Privacy-First Community Health Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "cd tests && npm run test:integration",
    "test:watch": "cd tests && npm run test:watch",
    "test:coverage": "cd tests && npm run test:coverage",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "prettier": "^3.1.0",
    "turbo": "^2.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "react-native-worklets": "^0.6.1"
  },
  "overrides": {
    "@karmyq/mobile": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  },
  "packageManager": "npm@10.8.2"
}
