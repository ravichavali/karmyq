# Production Environment Variables
# COPY THIS TO .env.production on the server

# Database
# Use a strong password!
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_production

# JWT Secret
# Generate a random string: openssl rand -base64 32
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Redis
REDIS_URL=redis://redis:6379

# Service URLs (Internal Docker Network)
AUTH_API_URL=http://auth-service:3001
COMMUNITY_API_URL=http://community-service:3002
REQUEST_API_URL=http://request-service:3003
REPUTATION_API_URL=http://reputation-service:3004
NOTIFICATION_API_URL=http://notification-service:3005
MESSAGING_API_URL=http://messaging-service:3006
FEED_API_URL=http://feed-service:3007
SOCIAL_GRAPH_API_URL=http://social-graph-service:3010

# Frontend Public URLs (Browser Access)
NEXT_PUBLIC_API_URL=https://karmyq.com/api/auth
NEXT_PUBLIC_COMMUNITY_API_URL=https://karmyq.com/api/communities
NEXT_PUBLIC_REQUEST_API_URL=https://karmyq.com/api/requests
NEXT_PUBLIC_REPUTATION_API_URL=https://karmyq.com/api/reputation
NEXT_PUBLIC_NOTIFICATION_API_URL=https://karmyq.com/api/notifications
NEXT_PUBLIC_MESSAGING_API_URL=https://karmyq.com/api/messages
NEXT_PUBLIC_FEED_API_URL=https://karmyq.com/api/feed
NEXT_PUBLIC_SOCIAL_GRAPH_API_URL=https://karmyq.com/api/social-graph
