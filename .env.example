# Environment Configuration

# Node Environment
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=info  # Options: debug, info, warn, error

# Database
DATABASE_URL=postgresql://karmyq_user:karmyq_password_dev@localhost:5432/karmyq_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret (Change in production!)
JWT_SECRET=dev_jwt_secret_change_in_production

# Service-to-service secret shared by request-service and social-graph-service
INTERNAL_SECRET=dev_internal_secret_change_in_production

# Read-only Maria demo session (Sprint 116, ADR-084). Disabled unless every value is set;
# the four story IDs come from a verified `rehearse:maria-relationship --apply` run.
DEMO_SESSION_ENABLED=false
DEMO_PERSONA_EMAIL=maria.reyes@test.karmyq.com
DEMO_ORDINARY_REQUEST_ID=
DEMO_ORDINARY_MATCH_ID=
DEMO_PROVIDER_REQUEST_ID=
DEMO_PROVIDER_OFFER_ID=

# API URLs (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_COMMUNITY_API_URL=http://localhost:3002
NEXT_PUBLIC_REQUEST_API_URL=http://localhost:3003
NEXT_PUBLIC_NOTIFICATION_API_URL=http://localhost:3005
NEXT_PUBLIC_MESSAGING_API_URL=http://localhost:3006

# CORS
CORS_ORIGIN=http://localhost:3000
