# Sprint 129 (BUG-039) — environment for `rotate:demo-stories` ONLY.
#
# WHY THIS IS A SEPARATE FILE, not part of `.env.demo`:
# `.env.demo` is consumed by docker-compose and injected into EVERY service container. It must
# never carry `DEMO_PERSONA_PASSWORD`. This file is read only by the operator shell that runs a
# rotation, is never referenced by compose, and must be chmod 600 on the host.
#
# BACKGROUND — read before running a rotation:
# The guided Maria demo is two live stories whose four server-generated IDs are stored as
# `DEMO_*` variables. `cleanup-service` hard-deletes expired help_requests 7 days after they
# expire (`scripts` → `services/cleanup-service/src/jobs/expirationJob.ts`, daily at 02:00), so
# those IDs go stale on a timer. The design's answer is to rotate the stories explicitly BEFORE
# they age out. That mechanism existed since Sprint 117 but was never wired on the demo host,
# which is why BUG-039 left karmyq.com/demo dead rather than rotated.
#
# USAGE (on the demo host, from the repo root):
#   cp .env.demo.rotation.example .env.demo.rotation && chmod 600 .env.demo.rotation
#   # fill in the values, then:
#   set -a; . ./.env.demo.rotation; set +a
#   npm --workspace @karmyq/simulation-service run rotate:demo-stories                    # dry run
#   npm --workspace @karmyq/simulation-service run rotate:demo-stories -- --apply --publish-config
#
# The rotation is fail-closed at every step: it creates the replacement stories, verifies them,
# and only then backs up and rewrites the five allowlisted keys in `.env.demo`, re-enables the
# demo, recreates auth-service and re-verifies a live demo session. If verification fails, no
# config is published.

# Base URL the rotation drives through ordinary APIs (stories are API-created, never hand-inserted).
API_BASE_URL=https://karmyq.com/api

# The narrative persona. Must be an active, non-admin @test.karmyq.com account.
# `DEMO_MARIA_EMAIL` falls back to `DEMO_PERSONA_EMAIL` if unset.
DEMO_MARIA_EMAIL=maria.reyes@test.karmyq.com

# Offers help on Maria's ordinary request — that offer IS the proposed match.
# MUST share at least one community with Maria or the rotation refuses.
DEMO_HELPER_EMAIL=elena.torres@test.karmyq.com

# Submits the provider offer on Maria's service request.
DEMO_PROVIDER_EMAIL=noah.williams@test.karmyq.com

# Used by the verifier to prove an out-of-audience account is denied. This account MUST share
# ZERO communities with Maria — otherwise the negative check can pass for the wrong reason.
# Re-derive it rather than trusting a stored value: demo accounts do not outlive a re-seed, and
# an account that was unrelated at seed time can be joined into Maria's communities by ambient
# simulation. Verified unrelated 2026-09-12.
DEMO_UNRELATED_EMAIL=marcus.white9924@test.karmyq.com

# Shared simulation account password (see services/simulation-service/src/config/default.json).
DEMO_PERSONA_PASSWORD=

# Absolute path to the compose env file the story IDs are published into.
DEMO_ENV_FILE=/home/ubuntu/karmyq/.env.demo

# Host-specific steps. Both are fail-closed: the rotation refuses to run if either is unset.
# Values MUST be quoted: this file is shell-sourced (`set -a; . ./.env.demo.rotation`), and an
# unquoted value containing spaces would run the script instead of assigning the variable.
# Paths are ABSOLUTE: `npm --workspace` sets cwd to services/simulation-service/, so a relative
# path here would not resolve. (The scripts themselves also re-anchor to the repo root.)
DEMO_ENABLE_CMD="bash /home/ubuntu/karmyq/scripts/demo/enable-demo.sh"
DEMO_RESTART_AUTH_CMD="bash /home/ubuntu/karmyq/scripts/demo/restart-auth.sh"
