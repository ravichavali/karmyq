{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$"],
      "passThroughEnv": ["KARMYQ_JEST_MAX_WORKERS"]
    },
    "@karmyq/tests#test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "cache": false,
      "passThroughEnv": ["KARMYQ_JEST_MAX_WORKERS"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
